# ============================================================
# xt-pms 前端环境变量模板
# 使用方式：
#   1. 复制为 .env.local（本地开发重写）
#   2. 或直接修改 .env.development / .env.production
# ============================================================

# 是否使用 Vite 代理转发请求
# true  = Vite dev server 代理 /api 请求到 VITE_API_URL
# false = 前端直接请求 VITE_API_URL（生产环境推荐）
VITE_IS_REQUEST_PROXY=true

# API 服务器地址
# 开发环境：http://127.0.0.1:8080
# 生产环境：https://your-api-domain.com
VITE_API_URL=http://127.0.0.1:8080

# API 路径前缀（与后端路由一致）
VITE_API_URL_PREFIX=/api
