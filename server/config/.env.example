# ============================================================
# xt-pms 环境变量配置模板
# 使用方式：cp .env.example .env 后修改实际值
# 优先级：OS 环境变量 > .env 文件 > config.yaml
# ============================================================

# 数据库连接
PMS_DB_HOST=127.0.0.1
PMS_DB_PORT=3306
PMS_DB_USER=production_pms
PMS_DB_PASSWORD=change_me
PMS_DB_NAME=production_pms

# JWT 签名密钥（openssl rand -hex 32）
PMS_JWT_SECRET=change_me_to_a_random_string_at_least_32_chars

# 密码加密 Pepper（openssl rand -hex 32）
PMS_SECURITY_PEPPER=change_me_to_a_random_string_at_least_32_chars
