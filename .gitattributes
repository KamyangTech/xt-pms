# Auto-detect text files and normalize line endings
* text=auto

# Go source files
*.go text eol=lf

# Shell scripts
*.sh text eol=lf

# Makefile
Makefile text eol=lf
*.mk text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Markdown
*.md text eol=lf

# Dockerfile
Dockerfile text eol=lf

# SQL
*.sql text eol=lf

# Web frontend files
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.less text eol=lf
*.html text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary

# Diff - set linguist language for better diffs
*.config.go linguist-language=Go
