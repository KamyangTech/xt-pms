# =============================================================================
# xt-pms 部署环境变量模板
# 使用方式：
#   1. 复制为 deploy/.env
#   2. 修改其中的敏感值
# =============================================================================

# 应用模式 (development / production)
APP_MODE=production

# MySQL 配置
# 警告：以下密码为占位符，部署前务必替换为强口令，否则存在严重安全风险！
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=production_pms
MYSQL_USER=production_pms
MYSQL_PASSWORD=change_me
# MYSQL_PORT=3307          # 生产环境建议留空，不暴露数据库端口到宿主机

# 服务端口
SERVER_PORT=9898
NGINX_PORT=80

# JWT 签名密钥 & 密码加密 Pepper（留空则自动随机生成，推荐保留自动生成）
# PMS_JWT_SECRET=
# PMS_SECURITY_PEPPER=

# 管理员账号（首次部署时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_REAL_NAME=管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
