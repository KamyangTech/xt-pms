# =============================================================================
# xt-pms 开发环境变量模板
# 使用方式：
#   1. 复制为 .env
#   2. 修改其中的敏感值
# =============================================================================

# 应用模式 (development / production)
APP_MODE=development

# Server 配置（会覆盖 server/config/config.yaml 中的值）
PMS_SERVER_PORT=9898
PMS_SERVER_CORS_ORIGINS=http://localhost:9800,http://127.0.0.1:9800

# 数据库配置
PMS_DB_HOST=127.0.0.1
PMS_DB_PORT=3306
PMS_DB_USER=production_pms
PMS_DB_PASSWORD=change_me
PMS_DB_NAME=production_pms

# JWT 签名密钥（开发环境可使用默认值，生产环境务必修改）
PMS_JWT_SECRET=your-jwt-secret-change-in-production

# 密码加密 Pepper（开发环境可使用默认值，生产环境务必修改）
PMS_SECURITY_PEPPER=your-pepper-change-in-production

# 日志级别 (debug / info / warn / error)
PMS_LOG_LEVEL=debug
