[Unit]
Description=Xt-PMS 生产管理系统
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/xt-pms
ExecStart=/opt/xt-pms/xt-pms
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/xt-pms/config /opt/xt-pms/uploads /opt/xt-pms/logs /opt/xt-pms/system-assets

# 环境变量
Environment=TZ=Asia/Shanghai

[Install]
WantedBy=multi-user.target
