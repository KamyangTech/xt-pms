{
  "name": "xt-pms",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Xt-PMS 是一款专为国内小微模具制造与注塑企业量身打造的生产管理系统。系统紧贴行业实际需求，覆盖订单录入、模具档案、工序管理、生产报工、产品交付等全流程环节，助力企业高效完成从订单到交付的数字化管理，实现生产流程的透明化与规范化，推动小微型制造企业的数字化转型。",
  "keywords": [
    "xt-pms",
    "production-management",
    "manufacturing",
    "vue3",
    "gin"
  ],
  "author": {
    "name": "kamyang",
    "email": "pms@xintest.cn",
    "url": "https://gitee.com/kamyang-tech"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/kamyang-tech/xt-pms.git"
  },
  "bugs": {
    "url": "https://gitee.com/kamyang-tech/xt-pms/issues"
  },
  "homepage": "https://gitee.com/kamyang-tech/xt-pms#readme",
  "type": "module",
  "scripts": {
    "dev": "vite --open --mode development",
    "dev:linux": "vite --mode development",
    "build:test": "vite build --mode test",
    "build": "vue-tsc --noEmit && vite build --mode release",
    "build:type": "vue-tsc --noEmit",
    "build:site": "vue-tsc --noEmit && vite build --mode site",
    "preview": "vite preview",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0",
    "lint:fix": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0 --fix",
    "lint:staged": "eslint --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "stylelint": "stylelint src/**/*.{html,vue,css,sass,less}",
    "stylelint:fix": "stylelint --fix src/**/*.{html,vue,css,sass,less}",
    "stylelint:staged": "stylelint --fix",
    "prepare": "node -e \"if(require('fs').existsSync('.git')){process.exit(1)}\" || is-ci || husky install",
    "site:preview": "npm run build && cp -r dist _site",
    "test": "echo \"no test specified,work in process\"",
    "test:coverage": "echo \"no test:coverage specified,work in process\""
  },
  "dependencies": {
    "@types/event-source-polyfill": "^1.0.5",
    "@vueuse/core": "^12.3.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.12",
    "echarts": "5.4.3",
    "event-source-polyfill": "^1.0.31",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "pinia": "2.1.7",
    "pinia-plugin-persistedstate": "^3.2.0",
    "qrcode.vue": "^3.4.1",
    "qs": "^6.13.1",
    "sortablejs": "^1.15.7",
    "tdesign-icons-vue-next": "^0.3.6",
    "tdesign-vue-next": "^1.13.2",
    "tvision-color": "^1.6.0",
    "vue": "^3.5.13",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "~4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.10.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/dompurify": "^3.0.5",
    "@types/echarts": "^4.9.21",
    "@types/lodash": "^4.17.6",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.17",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/compiler-sfc": "~3.3.8",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue-scoped-css": "^2.9.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "lint-staged": "^15.2.2",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^3.5.3",
    "rspack-resolver": "^1.1.1",
    "stylelint": "~16.16.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "~6.0.4",
    "terser": "^5.47.1",
    "typescript": "~5.4.3",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^2.2.8"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "prettier --write",
      "npm run lint:staged"
    ],
    "*.{html,vue,css,sass,less}": [
      "npm run stylelint:staged"
    ]
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
